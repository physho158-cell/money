# Required: create a bot with @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Required: free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=replace_me
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TRANSLATION_MODEL=openai/gpt-oss-120b

# my-MM-ThihaNeural = male, my-MM-NilarNeural = female
DEFAULT_VOICE=my-MM-ThihaNeural
TTS_RATE=+0%
VIDEO_ENHANCE=true

# Local development uses polling. Render Web Service uses webhook.
APP_MODE=polling
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=optional_long_random_value
PORT=10000

# Processing limits. Large 300 MB sources may require more CPU/RAM on free hosting.
MAX_VIDEO_SECONDS=120
MAX_DOWNLOAD_MB=300
MAX_OUTPUT_MB=45
MAX_QUEUE_SIZE=5
WORKERS=1
WORK_DIR=/tmp/myanmar-dubber
FFMPEG_TIMEOUT_SECONDS=900

# Optional: comma-separated Telegram numeric user IDs. Empty means public.
ALLOWED_USER_IDS=

# Optional: useful when a hosting provider requires YouTube cookies.
# YTDLP_COOKIES_FILE=/etc/secrets/youtube_cookies.txt

LOG_LEVEL=INFO
