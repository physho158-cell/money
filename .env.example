# Required: create a bot with @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Required: used for speech-to-text and Myanmar translation.
OPENAI_API_KEY=replace_me
WHISPER_MODEL=whisper-1
TRANSLATION_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# my-MM-NilarNeural = female, my-MM-ThihaNeural = male
DEFAULT_VOICE=my-MM-NilarNeural
TTS_RATE=+0%

# Processing limits (keep costs and Telegram upload sizes under control).
MAX_VIDEO_SECONDS=180
MAX_DOWNLOAD_MB=100
MAX_OUTPUT_MB=49
MAX_QUEUE_SIZE=20
WORKERS=1
WORK_DIR=/tmp/myanmar-dubber
FFMPEG_TIMEOUT_SECONDS=900

# Optional: comma-separated Telegram numeric user IDs. Empty means public.
ALLOWED_USER_IDS=

# Optional: useful when a hosting provider requires YouTube cookies.
# YTDLP_COOKIES_FILE=/run/secrets/youtube_cookies.txt

LOG_LEVEL=INFO
